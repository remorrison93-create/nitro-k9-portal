# --- Database ---
# Real Postgres connection string (Supabase / Neon / Railway / RDS, etc).
# `prisma generate` and `npm run dev` both work without a real one, but any page that
# queries the DB will error until this points at a live instance.
#
# On Supabase specifically: if you're deploying to a serverless host (Netlify, Vercel, etc.),
# use the connection *pooler* string, not the direct one. Supabase's direct connection host
# (db.<ref>.supabase.co) only resolves to an IPv6 address, and most serverless function
# runtimes (Netlify Functions/Lambda included) don't have outbound IPv6 — you'll get
# "Can't reach database server" errors on any page that touches the DB. The pooler host
# (aws-*.pooler.supabase.com, transaction mode, port 6543) is IPv4-compatible and built for
# exactly this. Find it in Supabase: Connect → ORM.
DATABASE_URL="postgresql://user:password@localhost:5432/nitro_k9"

# --- Auth ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Square (payments, and however contract-signed status ends up reaching us — see the
# note at the top of src/lib/integrations/square.ts) ---
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""

# --- Microsoft Graph (Outlook calendar) ---
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_CALENDAR_USER="" # the mailbox/UPN whose calendar is the source of truth

# --- Email ---
EMAIL_PROVIDER_API_KEY=""
